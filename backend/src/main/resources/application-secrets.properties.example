# =============================================================================
# 敏感配置模板 — 将此文件复制为 application-secrets.properties 并填写真实值
# 该文件已被 .gitignore 排除，不会提交到版本控制
# =============================================================================

# 数据库密码
spring.datasource.password=123456

# JWT 密钥（至少32个字符，生产环境务必修改）
jwt.secret=please-set-jwt-secret-in-application-secrets-properties

# DeepSeek AI API Key（https://platform.deepseek.com 获取，无需时可不填）
deepseek.api-key=
